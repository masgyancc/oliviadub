// BrewCC Ads Tracking: ad-platform tracking tags attached to a short link.
// Only validated IDs are stored (never user-supplied code); scripts are generated by BrewCC.
enum TrackingPlatform {
  meta
  tiktok
  google_ads
}

model LinkTrackingPixel {
  id              String           @id @default(cuid())
  linkId          String
  projectId       String // workspace that owns the link
  createdById     String?
  platform        TrackingPlatform
  pixelId         String // Meta/TikTok pixel id, or Google Ads conversion id (AW-…)
  conversionLabel String           @default("") // Google Ads conversion label ("" when not set)
  name            String?
  enabled         Boolean          @default(true)
  savedPixelId    String? // SavedTrackingPixel this tag was picked from (null when entered by hand)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([linkId, platform, pixelId, conversionLabel])
  @@index(projectId)
  @@index(savedPixelId)
}

// A user's own pixel library in a workspace, picked by checkbox in the link builder.
// Private to the user who saved it: never listed for other users, even in the same workspace.
model SavedTrackingPixel {
  id              String           @id @default(cuid())
  userId          String
  projectId       String
  platform        TrackingPlatform
  pixelId         String
  conversionLabel String           @default("")
  name            String           @db.VarChar(60)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, projectId, platform, pixelId, conversionLabel], map: "SavedTrackingPixel_user_pixel_key")
  @@index(projectId)
}
