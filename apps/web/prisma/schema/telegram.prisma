// BrewCC Telegram bot: a BrewCC user linked to a Telegram account (identified by the numeric Telegram user id)
model TelegramAccount {
  id                String    @id @default(cuid())
  userId            String    @unique // one Telegram account per BrewCC user
  telegramId        String    @unique // one BrewCC user per Telegram account
  telegramUsername  String?
  connectedAt       DateTime  @default(now())
  lastInteractionAt DateTime?
}

// A Telegram group connected to ONE workspace by its owner. Everything done in the group
// runs as the owner and only inside that workspace.
model TelegramGroup {
  id          String   @id @default(cuid())
  chatId      String   @unique // Telegram chat id of the group
  title       String?
  projectId   String // the only workspace this group can see
  ownerUserId String // BrewCC user who connected the group
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index(ownerUserId)
  @@index(projectId)
}

// Telegram users allowed to use the bot in a group (the owner is always allowed)
model TelegramGroupMember {
  id               String    @id @default(cuid())
  groupId          String
  telegramId       String
  telegramUsername String?
  displayName      String?
  status           String    @db.VarChar(16) // "pending" | "approved"
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?

  @@unique([groupId, telegramId])
  @@index(groupId)
}

// One-time token used to link a Telegram account from the dashboard (only the SHA-256 hash is stored)
model TelegramLinkToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index(userId)
  @@index(expiresAt)
}
