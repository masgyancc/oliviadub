// BrewCC: record of every action taken by a master admin
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorId      String // master admin who performed the action
  action       String // e.g. user.approve, user.reject, user.suspend, user.role, domain.disable
  targetUserId String?
  targetDomain String?
  fromValue    String?
  toValue      String?
  reason       String?  @db.Text
  createdAt    DateTime @default(now())

  @@index(actorId)
  @@index(targetUserId)
  @@index(createdAt)
}

// BrewCC: private note a master admin keeps about a user (e.g. who owns the email).
// Only visible to the admin who wrote it; never returned by any user-facing API.
model AdminUserAlias {
  id        String   @id @default(cuid())
  adminId   String // master admin who owns this alias
  userId    String // user the alias describes
  alias     String   @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([adminId, userId])
}

// BrewCC: global platform settings changed by master admins (key/value, e.g. allowUserDomains)
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
}
